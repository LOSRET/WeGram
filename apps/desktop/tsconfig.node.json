{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "paths": {
      "@wegram/mock-fixtures": ["../../packages/mock-fixtures/src/index.ts"],
      "@wegram/mock-session": ["../../packages/mock-session/src/index.ts"],
      "@wegram/protocol": ["../../packages/protocol/src/index.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vite.web.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "scripts/**/*.ts",
    "../../packages/mock-fixtures/src/**/*.ts",
    "../../packages/mock-session/src/**/*.ts",
    "../../packages/protocol/src/**/*.ts"
  ]
}
