{
  "name": "wegram",
  "version": "0.2.4",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @wegram/desktop dev",
    "build": "pnpm --filter @wegram/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:install": "pnpm --filter @wegram/desktop exec install-electron",
    "sync-version": "node scripts/sync-version.mjs",
    "check:version": "node scripts/check-version.mjs",
    "verify": "pnpm check:version && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
